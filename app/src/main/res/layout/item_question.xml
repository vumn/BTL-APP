<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_listview"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView
            android:id="@+id/lvIdQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="ID: Q1"
            android:textColor="#FFEB3B"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/lvContentQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Nội dung câu hỏi"
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lvAnswersQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="A. ... B. ... C. ... D. ..."
            android:textColor="#CCCCCC"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/lvCorrectQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Đáp án đúng: A"
            android:textColor="#4CAF50"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/lvLevelQuestion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Level: 1"
            android:textColor="#03A9F4"
            android:textSize="13sp" />

    </LinearLayout>

</FrameLayout>