<?xml version="1.0" encoding="utf-8"?>
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="24dp">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:src="@drawable/bg_trieuphu"
        android:scaleType="centerCrop"/>

    <View
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="#AA000000" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:background="@drawable/bg_dialog"
        android:elevation="16dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="#4F7F99"
            android:paddingStart="12dp"
            android:paddingEnd="12dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:text="CÀI ĐẶT"
                android:textColor="#FFFFFF"
                android:textSize="18sp"
                android:textStyle="bold"/>

            <ImageView
                android:id="@+id/btnClose"
                android:layout_width="26dp"
                android:layout_height="26dp"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:src="@android:drawable/ic_menu_close_clear_cancel"
                app:tint="#FFFFFF"/>
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Âm thanh"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <Switch
                    android:id="@+id/soundEnabled"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bật/Tắt âm thanh"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/soundCorrect"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Âm thanh đúng"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/soundWrong"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Âm thanh sai"
                    android:textColor="#FFFFFF"/>

                <Switch
                    android:id="@+id/soundMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Âm thanh menu"
                    android:textColor="#FFFFFF"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#66FFFFFF"
                    android:layout_marginVertical="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Chế độ chơi"
                    android:textColor="#FFD700"
                    android:textStyle="bold"
                    android:textSize="16sp"/>

                <Spinner
                    android:id="@+id/gameMode"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thời gian mỗi câu (giây)"
                    android:textColor="#FFD700"
                    android:layout_marginTop="12dp"/>

                <TextView
                    android:id="@+id/timeValue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="30 giây"
                    android:textColor="#FFFFFF"
                    android:layout_marginBottom="4dp"/>

                <SeekBar
                    android:id="@+id/timeSeek"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:max="60"
                    android:progress="30"/>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:background="#66FFFFFF"
                    android:layout_marginVertical="12dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Phiên bản: 3.2.1"
                    android:textColor="#BBBBBB"
                    android:textSize="14sp"/>

            </LinearLayout>

        </ScrollView>

    </LinearLayout>

</FrameLayout>